{
  "name": "qsmp",
  "version": "0.1.0",
  "scripts": {
    "dev": "cross-env NEXT_PUBLIC_APP_ENV=development next dev",
    "qa": "cross-env NEXT_PUBLIC_APP_ENV=qa next dev",
    "build": "cross-env NEXT_PUBLIC_APP_ENV=production next build",
    "build:qa": "cross-env NEXT_PUBLIC_APP_ENV=qa next build",
    "start:qa": "cross-env NEXT_PUBLIC_APP_ENV=qa next start --port 8082",
    "start": "cross-env NEXT_PUBLIC_APP_ENV=production next start --port 8080",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "dependencies": {
    "@jaredreisinger/react-crossword": "5.2.0",
    "@tanstack/react-query": "5.105.3",
    "clsx": "^2.1.0",
    "cross-env": "^7.0.3",
    "cva": "npm:class-variance-authority@0.7.0",
    "embla-carousel": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "2.4.1",
    "react-lazy-load": "4.0.1",
    "react-lite-youtube-embed": "2.4.0",
    "react-tweet": "3.1.1",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.91.0",
    "postcss": "^8",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "oxlint --fix"
    ],
    "*.{json,css,md}": "prettier --write"
  }
}
